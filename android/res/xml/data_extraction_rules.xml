<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: the same rules for cloud backup and phone-to-phone transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="orbit_sms.xml" />
        <exclude domain="sharedpref" path="orbit_social.xml" />
        <exclude domain="sharedpref" path="orbit_update.xml" />
        <exclude domain="file" path="www" />
        <exclude domain="file" path="updates" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="orbit_sms.xml" />
        <exclude domain="sharedpref" path="orbit_social.xml" />
        <exclude domain="sharedpref" path="orbit_update.xml" />
        <exclude domain="file" path="www" />
        <exclude domain="file" path="updates" />
    </device-transfer>
</data-extraction-rules>
